# User local settings (may contain machine paths)
config.json
config.local.json
config.json.bak
config.json.*.tmp
logs/
.impeccable/

# Huge third-party mod payload (~1.8GB, 40k+ files) â€” NOT for the git tree.
# This is intentional so clones stay small. The pack is NOT discarded:
#   - local working copy: pack\
#   - cloud backup: GitHub Releases BDO-AIO-v*-full.7z
#   - disk backup: Z:\Backup\BDO-mods-assets\
# See BACKUP.md and pack/README.md.
pack/**
!pack/README.md

# Experimental OptiScaler / Streamline binaries (large) â€” same backup model
# Keep warnings/docs only in git; full binaries ride in *-full.7z releases
experimental/dlss/OptiScaler/**
experimental/dlss/Streamline/**
experimental/dlss/optional/**
!experimental/dlss/WARNING.txt
!experimental/dlss/README.txt
!experimental/dlss/.gitkeep

# OS / editor junk
Thumbs.db
Desktop.ini
.DS_Store
*.log
__pycache__/
*.pyc
.vscode/
.idea/

# Accidental game-side backups if copied in
BDO-AIO-backup-dlss-*/
files_to_patch/
tools/bdo_meta/_sample/
tools/bdo_meta/_test_out/
tools/bdo_meta/_slot_test/
tools/bdo_meta/_pubic_test/

tools/nvidiaProfileInspector/*.pdb

backup/
