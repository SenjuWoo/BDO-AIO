    </StackPanel>
    <StackPanel x:Name="RecoveryPanel" Visibility="Collapsed">
     <DockPanel><Button x:Name="RecoveryCheckButton" Content="Check recovery options" DockPanel.Dock="Right" Margin="16,0,0,0"/><TextBlock x:Name="RecoveryTitle" Text="Review before changing anything" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
     <TextBlock Text="Checks read the meta, backup and archive bounds. They do not patch, repair or restore the game." Style="{StaticResource Help}" Margin="0,10,0,16"/>
     <TextBlock x:Name="RecoveryEvidence" Text="No recovery preview yet. Check options to see what is available for this installation." TextWrapping="Wrap"/>
     <Label Content="Recovery action" Target="{Binding ElementName=RecoveryChoice}" Padding="0" Margin="0,24,0,6"/><ComboBox x:Name="RecoveryChoice" AutomationProperties.Name="Recovery action"/>
     <Border BorderBrush="#DED9CF" BorderThickness="0,1,0,1" Padding="0,16" Margin="0,18,0,16"><StackPanel>
      <TextBlock x:Name="RecoveryReason" Text="Select an action, then check recovery options." TextWrapping="Wrap" FontWeight="SemiBold"/>
      <TextBlock x:Name="RecoveryChanges" Text="Your saved settings and files_to_patch are kept by all native recovery actions." Style="{StaticResource Help}"/>
      <TextBox x:Name="RecoveryFiles" Visibility="Collapsed" Height="140" IsReadOnly="True" AcceptsReturn="True" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" Margin="0,12,0,0" AutomationProperties.Name="Exact archive move list"/>
     </StackPanel></Border>
     <CheckBox x:Name="RecoveryAcknowledge" IsEnabled="False"><TextBlock x:Name="RecoveryAcknowledgementText" Text="Review the preview before confirming." TextWrapping="Wrap"/></CheckBox>
     <Button x:Name="RecoveryApplyButton" Content="Apply reviewed action" IsEnabled="False" Style="{StaticResource Primary}" HorizontalAlignment="Left" Margin="0,14,0,0"/>
     <TextBlock x:Name="RecoveryOutcome" Text="No recovery action has been run in this session." Style="{StaticResource Help}" Margin="0,16,0,0" AutomationProperties.LiveSetting="Polite"/>
     <WrapPanel Margin="0,12,0,0"><Button x:Name="RecoveryFilesButton" Content="Open retained recovery files" Margin="0,0,10,8"/><Button x:Name="PresetBackupsButton" Content="Open preset backups" Margin="0,0,0,8"/></WrapPanel>
     <TextBlock Text="After a game update" Style="{StaticResource Heading}"/>
     <TextBlock Text="1. Let Steam or the game launcher finish patching / repair.&#10;2. Close the game and launcher, then check recovery options again.&#10;3. Create a current-client reference only after patch / repair is complete.&#10;4. Reapply saved choices, complete PartCutGen and inject / verify before playing modded characters." Style="{StaticResource Help}"/>
     <TextBlock Text="Body limits: loading a character above stock limits while vanilla can clamp and resave its shape. Reapply body limits before loading that character. A local preset backup cannot restore lost server-side values." Foreground="#993B31" TextWrapping="Wrap" Margin="0,14,0,0"/>
    </StackPanel>
    <StackPanel x:Name="GraphicsPanel" Visibility="Collapsed">
     <DockPanel><Button x:Name="GraphicsCheckButton" Content="Preview profile" DockPanel.Dock="Right" Margin="16,0,0,0"/><TextBlock x:Name="GraphicsTitle" Text="Preview before changing GameOption.txt" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
     <TextBlock Text="These profiles merge known current-client quality keys into your complete GameOption.txt. They do not replace the file or invent hidden settings." Style="{StaticResource Help}" Margin="0,10,0,16"/>
     <Label Content="GameOption profile" Target="{Binding ElementName=GraphicsProfile}" Padding="0" Margin="0,8,0,6"/><ComboBox x:Name="GraphicsProfile" AutomationProperties.Name="GameOption graphics profile"/>
     <TextBlock x:Name="GraphicsEvidence" Text="Choose a profile and preview it. Preview reads the current file and makes no changes." TextWrapping="Wrap" Margin="0,14,0,0"/>
     <TextBox x:Name="GraphicsPreview" Height="150" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" Margin="0,14,0,16" AutomationProperties.Name="Graphics profile preview"/>
     <CheckBox x:Name="GraphicsAcknowledge" IsEnabled="False"><TextBlock Text="I reviewed the changed-key list. A complete GameOption backup will be created beside the current file before applying." TextWrapping="Wrap"/></CheckBox>
     <Button x:Name="GraphicsApplyButton" Content="Apply reviewed profile" IsEnabled="False" Style="{StaticResource Primary}" HorizontalAlignment="Left" Margin="0,14,0,0"/>
     <TextBlock x:Name="GraphicsOutcome" Text="No graphics profile has been applied in this session." Style="{StaticResource Help}" Margin="0,14,0,0" AutomationProperties.LiveSetting="Polite"/>
     <Border BorderBrush="#DED9CF" BorderThickness="0,1,0,1" Padding="0,16" Margin="0,20,0,16"><StackPanel>
      <TextBlock Text="NVIDIA driver profile" FontSize="17" FontWeight="SemiBold"/>
      <TextBlock x:Name="GraphicsNvidiaStatus" Text="NVIDIA Profile Inspector status will be checked here." Style="{StaticResource Help}" Margin="0,6,0,10" TextWrapping="Wrap"/>
      <WrapPanel><Button x:Name="GraphicsNvidiaButton" Content="Open NVIDIA Profile Inspector" Margin="0,0,10,8"/><Button x:Name="GraphicsNvidiaReadmeButton" Content="Open driver profile notes" Margin="0,0,0,8"/></WrapPanel>
      <TextBlock Text="The .nip import stays in NVIDIA Profile Inspector so its own driver confirmation and rollback behavior remain visible. Experimental DLSS / OptiScaler remains separate." Style="{StaticResource Help}" TextWrapping="Wrap"/>
     </StackPanel></Border>
     <TextBlock Text="Close Black Desert before applying GameOption or importing the NVIDIA profile. Graphics appearance and FPS still require your in-game retest." Foreground="#7A5A20" TextWrapping="Wrap"/>
    </StackPanel>
    <StackPanel x:Name="ToolsPanel" Visibility="Collapsed">
     <TextBlock Text="Individual pipeline steps" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Use these when repeating one part of a run. A full apply runs them in order." Style="{StaticResource Help}"/>
     <WrapPanel Margin="0,14,0,0"><Button Tag="Deploy" Content="Deploy Midnight" Margin="0,0,10,10"/><Button Tag="Restored" Content="Generate selected options" Margin="0,0,10,10"/><Button Tag="PartCut" Content="Run PartCutGen" Margin="0,0,10,10"/><Button Tag="Inject" Content="Inject &amp; verify" Margin="0,0,10,10"/></WrapPanel>
     <Separator/><TextBlock Text="Checks &amp; recovery" Style="{StaticResource Heading}"/><TextBlock Text="Recovery keeps the existing confirmations and Customization backup safeguards. A status scan does not prove in-game appearance." Style="{StaticResource Help}"/>
     <WrapPanel Margin="0,14,0,0"><Button Tag="VerifyMeta" Content="Verify current meta" Margin="0,0,10,10"/><Button Tag="VerifyPack" Content="Check pack files" Margin="0,0,10,10"/><Button x:Name="RecoveryPageButton" Content="Recovery &amp; updates" Margin="0,0,10,10"/><Button x:Name="UpdatePageButton" Content="After a game update" Margin="0,0,10,10"/></WrapPanel>
     <Separator/><TextBlock Text="Graphics &amp; reference" Style="{StaticResource Heading}"/>
     <WrapPanel><Button x:Name="GraphicsPageButton" Content="Graphics &amp; performance..." Margin="0,0,10,10"/><Button x:Name="GraphicsNvidiaPageButton" Content="NVIDIA profile..." Margin="0,0,10,10"/><Button Tag="Dlss" Content="Experimental upscaling..." Margin="0,0,10,10"/><Button Tag="Guide" Content="Modding guide" Margin="0,0,10,10"/><Button Tag="Menu" Content="Classic console" Margin="0,0,10,10"/></WrapPanel>
    </StackPanel>
    <StackPanel x:Name="ActivityPanel" Visibility="Collapsed">
     <TextBlock x:Name="OperationLabel" Text="No operation is running." FontSize="20" FontWeight="SemiBold"/><TextBlock x:Name="RunTiming" Text="No recorded injection run yet. Timings appear after a run from this build." Style="{StaticResource Help}" Margin="0,8,0,14"/>
     <ProgressBar x:Name="OperationProgress" Height="4" Visibility="Collapsed" Foreground="#987337" Margin="0,0,0,14"/>
     <TextBox x:Name="ActivityText" Height="330" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" Padding="14" Text="Tool output and results will appear here. External tools keep their own console windows." AutomationProperties.Name="Operation log"/>
     <WrapPanel Margin="0,16,0,0"><Button x:Name="LogsButton" Content="Open logs folder" Margin="0,0,10,0"/><Button x:Name="CopyLogButton" Content="Copy visible log"/></WrapPanel>
    </StackPanel>
   </Grid></ScrollViewer>
   <Border Grid.Row="2" BorderBrush="#DED9CF" BorderThickness="0,1,0,0" Background="#EEEBE3" Padding="32,16"><Grid>
    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBlock x:Name="SaveState" Text="Settings loaded. Nothing applied." AutomationProperties.LiveSetting="Assertive" VerticalAlignment="Center" Margin="0,0,16,0" Foreground="#586162"/>
    <Button x:Name="ReloadButton" Grid.Column="1" Content="_Reload" Margin="0,0,10,0"/><Button x:Name="SaveButton" Grid.Column="2" Content="_Save settings" Style="{StaticResource Primary}"/>
   </Grid></Border>
  </Grid>
 </Grid>
 </Grid>
</Window>
